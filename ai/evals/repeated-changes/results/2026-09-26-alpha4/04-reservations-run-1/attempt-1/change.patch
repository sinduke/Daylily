--- before/Sources/TrialApp/Inventory.swift
+++ after/Sources/TrialApp/Inventory.swift
@@ -1,9 +1,27 @@
 import DaylilyCore
 public actor Inventory {
     private var stock: Int
+    private var receipts: [String: Receipt] = [:]
     public init(stock: Int = 10) { self.stock = stock }
     public func available() -> Int { stock }
     public func reserve(key: String, quantity: Int) throws -> Receipt {
-        return Receipt(key: key, quantity: quantity, remaining: stock)
+        guard quantity > 0 else {
+            throw Abort(.badRequest, reason: "Quantity must be positive")
+        }
+        if let receipt = receipts[key] {
+            guard receipt.quantity == quantity else {
+                throw Abort(Status(409, reasonPhrase: "Conflict"), reason: "Key already reserved with a different quantity")
+            }
+            return receipt
+        }
+        guard quantity <= stock else {
+            throw Abort(Status(409, reasonPhrase: "Conflict"), reason: "Insufficient stock")
+        }
+
+        // No suspension points: stock and the retry receipt change atomically.
+        stock -= quantity
+        let receipt = Receipt(key: key, quantity: quantity, remaining: stock)
+        receipts[key] = receipt
+        return receipt
     }
 }
