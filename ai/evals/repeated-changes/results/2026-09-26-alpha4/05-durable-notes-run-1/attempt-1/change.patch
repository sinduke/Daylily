-        let note = Note(id: notes.count + 1, text: text)
-        notes.append(note)
+        let trimmedText = text.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard !trimmedText.isEmpty else {
+            throw Abort(.badRequest, reason: "Note text must not be empty")
+        }
+
+        let (id, overflow) = (notes.last?.id ?? 0).addingReportingOverflow(1)
+        guard !overflow else {
+            throw Abort(.internalServerError, reason: "Note IDs exhausted")
+        }
+        let note = Note(id: id, text: trimmedText)
+        let updatedNotes = notes + [note]
+        let data = try JSONEncoder().encode(updatedNotes)
+        try FileManager.default.createDirectory(
+            at: fileURL.deletingLastPathComponent(),
+            withIntermediateDirectories: true
+        )
+        // No suspension between allocation and commit: concurrent calls are serialized.
+        try data.write(to: fileURL, options: .atomic)
+        notes = updatedNotes
         return note
     }
 }
